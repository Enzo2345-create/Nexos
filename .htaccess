Options -Indexes -MultiViews
RewriteEngine On

# Rotas de arquivos estáticos dentro de public/.
RewriteRule ^public/ - [L]
RewriteRule ^(assets|css|fonts|img|js|uploads)/(.*)$ public/$1/$2 [L]
RewriteRule ^$ public/index.php [QSA,L]

# Não expõe os diretórios internos do projeto.
RewriteRule ^(app|config|database|storage|bin)(/|$) - [F,L]

# Entrega as rotas do site ao controlador frontal, mantendo o caminho em ?url=.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
